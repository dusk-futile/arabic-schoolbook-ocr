# The application is fully usable in Local mode without cloud credentials.
TRAINING_APPROVED=false
JOB_ROOT=jobs
MAX_UPLOAD_MB=500

# Azure is called only when a job has cloud_opt_in=true.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_PRICE_PER_1000_PAGES=

# Gemini receives selected crops only unless separate selected-full-page consent is recorded.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ENABLE_GEMINI_VERIFICATION=false
ENABLE_GEMINI_FORMATTING=false
ENABLE_GEMINI_VISUAL_QA=false
GEMINI_VERIFY_CONFIDENCE_THRESHOLD=0.85
GEMINI_CORRECTION_CONFIDENCE_THRESHOLD=0.95
GEMINI_VERIFY_DIGITS_ALWAYS=true
GEMINI_VERIFY_ENGLISH_ALWAYS=true
GEMINI_VERIFY_HEADINGS_ALWAYS=true
GEMINI_MAX_RETRIES=2
GEMINI_MAX_PARALLEL_REQUESTS=4
GEMINI_INPUT_PRICE_PER_MILLION_TOKENS=
GEMINI_OUTPUT_PRICE_PER_MILLION_TOKENS=

# Optional remote Unlimited-OCR research endpoint. Local BF16 requires >=8 GB VRAM.
UNLIMITED_OCR_REMOTE_ENDPOINT=
UNLIMITED_OCR_REMOTE_TOKEN=
